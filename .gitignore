# 沙箱工具清单（运行时数据，按用户生成）
.sandbox_manifests/
# 沙箱产出文件（会话收尾时回传，运行时数据）
artifacts/
# 平台技能库是运行时数据（管理员/用户发布产生），不进仓库
skills-platform/

# 运行时产物（评测报告、日志轮转备份）
docs/eval-report-*.md
*.log.bak.*
*.log.*.bak

# drawio 自动备份
*.bkp
.$*.bkp

# MCP 服务的独立虚拟环境（体积大，不入库）
src/plugins/mcp/**/.venv/

# pytest 缓存（跑测试时用 -p no:cacheprovider，避免在仓库根留临时目录）
.pytest_cache/
pytest-cache-files-*/

# 本地辅助（askpass 等，不参与部署）
.tools/

# ---- 本地覆盖配置（configs.cfg 入库但只放非敏感项；密钥一律走环境变量）----
config/configs.local.cfg
.env
*.env
.env.*
*.pem
auth.json

# ---- 运行时产物 ----
frontend/dist/
docs/测试与压测报告-2026-11-06.md

# 知识库上传的原始文件（运行时数据，不入库）
data/

