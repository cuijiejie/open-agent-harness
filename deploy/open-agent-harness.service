[Unit]
Description=Open Agent Harness - 智能体平台
Documentation=file:///opt/open-agent-harness/docs/部署说明.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/open-agent-harness

# 密钥与口令从这个文件读（不存在也不影响启动，前面的 - 表示可选）
EnvironmentFile=-/opt/open-agent-harness/.env
Environment=PYTHONUNBUFFERED=1

# 并发模型：uvicorn 多进程 worker（异步 IO，一条 SSE 不占线程）。
# worker 数按内存给：每个 worker 常驻约 300~400MB（含 langgraph 依赖）。
Environment=PYTHONPATH=/opt/open-agent-harness
ExecStart=/opt/open-agent-harness/.venv/bin/python -m uvicorn \
  src.app_fastapi:app \
  --host 0.0.0.0 --port 5001 --workers 4

Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=90
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
