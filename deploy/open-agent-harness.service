[Unit]
Description=Open Agent Harness - 智能体平台
Documentation=file:///opt/open-agent-harness/docs/部署说明.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/open-agent-harness

# 密钥与口令从这个文件读（不存在也不影响启动，前面的 - 表示可选）
EnvironmentFile=-/opt/open-agent-harness/.env
Environment=PYTHONUNBUFFERED=1

# 并发参数都在 gun_conf.py 里（6 worker × 4 thread = 24 并发槽、gthread、timeout 1300），
# 这里只覆盖监听地址。要改并发请改 gun_conf.py，别在单元文件里另写一套。
ExecStart=/opt/open-agent-harness/.venv/bin/gunicorn \
  --config /opt/open-agent-harness/gun_conf.py \
  --bind 0.0.0.0:5001 \
  AgentApp:app

Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=90
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
