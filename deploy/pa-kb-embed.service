[Unit]
Description=OAH KB Embedding Service (bge ONNX, localhost only)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/open-agent-harness
Environment=PYTHONPATH=/opt/open-agent-harness
Environment=PYTHONUNBUFFERED=1
# 模型下载走镜像（内网/下载慢时必需）
Environment=HF_ENDPOINT=https://hf-mirror.com
# 模型缓存目录：fastembed 默认落在 $TMPDIR/fastembed_cache（重启可能被清），
# 固定到 /var/lib/oah-embed，首次手动下载一次即可长期复用
Environment=FASTEMBED_CACHE_PATH=/var/lib/oah-embed
# 模型已落盘后强制离线：huggingface_hub 0.36 走 xet/分片下载，经镜像拉 1.1GB
# 的 model.onnx 会卡在 0%（小文件正常），离线读取缓存可完全绕开
Environment=HF_HUB_OFFLINE=1
# fastembed 0.4.2 里没有 bge-base-zh-v1.5；bge-small-zh 只有 Google Storage 源
# 这个模型有 HF 源、768 维，内网可离线部署
Environment=EMBED_MODEL=BAAI/bge-m3
# bge-m3 不在 fastembed 清单里 → 走本地 ONNX（onnxruntime + tokenizers）
Environment=EMBED_ONNX_DIR=/var/lib/oah-embed/bge-m3-src/onnx
# 重排默认关闭：无 GPU 时两个模型同进程会打满内存，嵌入从 0.3s 掉到 8s
# 有 GPU / 机器够强时改成 BAAI/bge-reranker-base
Environment=RERANK_MODEL=none
Environment=EMBED_THREADS=4
# 独立环境：只装 fastembed + uvicorn，不污染主服务（换机器时改这一行路径）
ExecStart=/home/cuijie/miniforge3/envs/oah-embed/bin/python -m src.kb_embed_server --host 127.0.0.1 --port 5110
Restart=always
RestartSec=5
# 一个进程一份模型，约 300~600MB
MemoryMax=2G

[Install]
WantedBy=multi-user.target
